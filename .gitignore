# ─── Secrets / environment ────────────────────────────────────────────────────
.env

# ─── Claude Code ──────────────────────────────────────────────────────────────
.claude/
CLAUDE.md

# ─── Magento source (composer-managed, not committed) ────────────────────────
src/

# ─── Project init state ───────────────────────────────────────────────────────
.made

# ─── Root dependencies (Robo + tools) ────────────────────────────────────────
vendor/
# All composer-managed binaries (regenerated by: ./setup)
bin/

# ─── Volumes (host-mounted user data) ────────────────────────────────────────
volumes/.composer/
volumes/.ssh/

# ─── Legacy OpenSearch bind-mount (now a named Docker volume) ────────────────
elasticsearch/

# ─── Database dumps (robo db:dump / robo upgrade) ────────────────────────────
*.sql
*.sql.gz

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
