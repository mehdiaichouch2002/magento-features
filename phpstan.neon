parameters:
    level: 8
    paths:
        - modules/
    excludePaths:
        analyseAndScan:
            - modules/*/*/Test/*
            - modules/*/*/vendor/*
    # Magento classes are not installed on the host; point this at the
    # Magento autoloader to analyse against the real framework:
    #   bootstrapFiles: [src/vendor/autoload.php]
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: missingType.iterableValue
        # Magento abstract model magic getters/setters
        - '#Call to an undefined method Magento.Framework.Model.AbstractModel::#'
