<?xml version="1.0"?>
<ruleset name="Magento2 Lab">
    <description>PHPCS ruleset for the Magento 2 Innovation Lab</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg name="extensions" value="php,phtml"/>
    <arg value="sp"/>

    <!-- Target only custom modules -->
    <file>modules/</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Official Magento coding standard (includes PSR-12 and PHPCompatibility).
         Registered automatically by dealerdirect/phpcodesniffer-composer-installer. -->
    <rule ref="Magento2"/>

    <!-- Tests may use relaxed rules -->
    <rule ref="Magento2.Functions.StaticFunction">
        <exclude-pattern>*/Test/*</exclude-pattern>
    </rule>

    <rule ref="Generic.PHP.NoSilencedErrors"/>
</ruleset>
