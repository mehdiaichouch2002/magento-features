{
    "name": "aichouchm/magento-innovation-lab",
    "description": "Magento 2 personal innovation lab – dev tooling",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "consolidation/robo": "^5.1",
        "symfony/console": "^6.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "bin-dir": "bin",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "bin/phpcs --standard=phpcs.xml",
        "lint:fix": "bin/phpcbf --standard=phpcs.xml",
        "analyse": "bin/phpstan analyse --configuration=phpstan.neon"
    }
}
