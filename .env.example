# ─── Magento Marketplace credentials ─────────────────────────────────────────
# Free account required: https://commercemarketplace.adobe.com/customer/accessKeys/
# ./setup asks for these interactively if left empty.
MAGENTO_REPO_PUBLIC_KEY=
MAGENTO_REPO_PRIVATE_KEY=

# ─── Magento ──────────────────────────────────────────────────────────────────
MAGENTO_VERSION=2.4.9
MAGENTO_MODE=developer
# *.localhost resolves to 127.0.0.1 in every modern browser and in curl,
# so no /etc/hosts edit is needed.
MAGENTO_BASE_URL=http://magento.localhost/
MAGENTO_ADMIN_URI=admin
MAGENTO_ADMIN_FIRSTNAME=Admin
MAGENTO_ADMIN_LASTNAME=User
MAGENTO_ADMIN_EMAIL=admin@example.com
MAGENTO_ADMIN_USER=admin
MAGENTO_ADMIN_PASSWORD=Admin123!

# ─── Service versions ─────────────────────────────────────────────────────────
# Defaults match the Magento 2.4.9 system requirements.
# For 2.4.8-p5 use: PHP_VERSION=8.4  MARIADB_VERSION=11.8  VALKEY_VERSION=8.1
# Changing PHP_VERSION needs a rebuild: robo build
PHP_VERSION=8.5
MARIADB_VERSION=12.3
OPENSEARCH_VERSION=3.1.0
VALKEY_VERSION=9.0
RABBITMQ_VERSION=4.3
VARNISH_VERSION=8.0
NGINX_VERSION=1.30

# ─── PHP ──────────────────────────────────────────────────────────────────────
PHP_MEMORY_LIMIT=2G
PHP_MEMORY_LIMIT_CLI=4G
XDEBUG_ENABLED=false

# ─── Nginx ────────────────────────────────────────────────────────────────────
# Port 8080: direct PHP access (bypass Varnish)
# Port  80 : via Varnish (FPC enabled)
NGINX_DIRECT_PORT=8080

# ─── Varnish ──────────────────────────────────────────────────────────────────
VARNISH_PORT=80
VARNISH_SIZE=256m

# ─── MariaDB ──────────────────────────────────────────────────────────────────
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=magento
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento

# ─── OpenSearch ───────────────────────────────────────────────────────────────
OPENSEARCH_PORT=9200
OPENSEARCH_HEAP=512m

# ─── Valkey (Redis-compatible cache / sessions) ───────────────────────────────
VALKEY_PORT=6379
VALKEY_MAXMEMORY=512mb

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=magento
RABBITMQ_VHOST=magento

# ─── Mailpit (catches all outbound email) ─────────────────────────────────────
MAILPIT_HTTP_PORT=8025
